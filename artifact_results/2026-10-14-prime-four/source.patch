+fn invert_nonzero<F: FieldElement>(values: &mut [F]) {
+    let mut prefixes = Vec::with_capacity(values.len());
+    let mut product = F::ONE;
+    for &value in values.iter() {
+        prefixes.push(product);
+        product *= value;
+    }
